# Safe to expose only in the frontend build; this is a Paystack PUBLIC key.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_WITH_YOUR_PUBLIC_KEY

# NEVER put this in VITE_ variables or commit it to GitHub.
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_SECRET_KEY

# Supabase server-side credentials.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Central Galaxy Fire sale notifications.
# If SALES_NOTIFICATION_EMAIL is omitted, the code defaults to galaxyfirestudios@gmail.com.
SALES_NOTIFICATION_EMAIL=galaxyfirestudios@gmail.com

# Resend is the outbound email provider used by the server.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Galaxy Fire Studios <verified-sender@yourdomain.com>

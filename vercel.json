{
  "functions": {
    "api/verify-payment.js": {
      "maxDuration": 10
    },
    "api/paystack-config.js": {
      "maxDuration": 5
    },
    "api/check-availability.js": {
      "maxDuration": 10
    },
    "api/verify-beat-payment.js": {
      "maxDuration": 10
    },
    "api/beat-status.js": {
      "maxDuration": 10
    },
    "api/paystack-webhook.js": {
      "maxDuration": 10
    },
    "api/verify-store-payment.js": {
      "maxDuration": 10
    },
    "api/editorial-scan.js": {
      "maxDuration": 30
    },
    "api/artist-submission.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/radio/(.*)\\.mp3",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/editorial-feed.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=300"
        }
      ]
    }
  ]
}
